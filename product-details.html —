<div class="modal" id="enquiryModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
<div class="modal-box">
<button class="modal-close" id="closeModal" type="button" aria-label="Close">×</button>
<div class="eyebrow">Artwork enquiry</div>
<h2 id="modalTitle">Enquire about this artwork</h2>
<p id="modalArtworkName">Artwork details</p>
<form id="enquiryForm">
<div class="form-row">
<label for="customerName">Your name</label>
<input id="customerName" name="name" required maxlength="100" autocomplete="name">
</div>
<div class="form-row">
<label for="customerEmail">Email address</label>
<input id="customerEmail" name="email" type="email" required maxlength="160" autocomplete="email">
</div>
<div class="form-row">
<label for="customerMessage">Your message</label>
<textarea id="customerMessage" name="message" required maxlength="1000"></textarea>
</div>
<button class="form-submit" type="submit">Prepare Enquiry Message</button>
<div class="status" id="formStatus" role="status"></div>
</form>
</div>
</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged artwork image">
<button id="closeLightbox" aria-label="Close image">×</button>
<img id="lightboxImage" src="" alt="Enlarged artwork">
</div>

<script>
const $=selector=>document.querySelector(selector);

function toggleMenu(){
 $('#mobileMenu').classList.toggle('open');
}

/* Read the artwork selected on Explore Art */
const products={
 'photography-collection':{
  title:'Photography Collection',
  category:'Photography',
  artist:'Kaalaverse Creator',
  image:'assets/client-image-3.jpg',
  description:'Explore visual storytelling from the Kaalaverse photography collection.'
 },
 'wildlife-nature-collection':{
  title:'Wildlife & Nature Collection',
  category:'Wildlife & Nature',
  artist:'Kaalaverse Creator',
  image:'assets/client-image-5.jpg',
  description:'Discover nature-focused imagery from the client-provided collection.'
 },
 'visual-art-collection':{
  title:'Visual Art Collection',
  category:'Visual Art',
  artist:'Kaalaverse Creator',
  image:'assets/client-image-2.jpg',
  description:'Explore the visual art category from Kaalaverse.'
 }
};

const params=new URLSearchParams(window.location.search);
const item=params.get('item')||'';
const product=products[item]||null;

if(product){
 $('#productTitle').textContent=product.title;
 $('#productCategory').textContent=product.category;
 $('#artistName').textContent=product.artist;
 $('#productImage').src=product.image;
 $('#productImage').alt=product.title;
 $('#productDescription').textContent=product.description;
 $('#longDescription').textContent=product.description+' Contact the Kaalaverse team for confirmed artwork details.';
 $('#specCategory').textContent=product.category;
 $('#specArtist').textContent=product.artist;
 $('#modalArtworkName').textContent=product.title;
 document.title=product.title+' | Kaalaverse';
 $('#thumbnails').innerHTML=`
  <button class="thumb active" data-image="${product.image}" aria-label="View artwork image">
   <img src="${product.image}" alt="">
  </button>`;
}else{
 $('#productTitle').textContent='Artwork Details';
 $('#modalArtworkName').textContent='General artwork enquiry';
}

/* Image gallery */
$('#thumbnails').addEventListener('click',event=>{
 const button=event.target.closest('[data-image]');
 if(!button)return;

 $('#productImage').src=button.dataset.image;
 document.querySelectorAll('.thumb').forEach(thumb=>thumb.classList.remove('active'));
 button.classList.add('active');
});

$('#mainImage').addEventListener('click',()=>{
 $('#lightboxImage').src=$('#productImage').src;
 $('#lightbox').classList.add('open');
});

function closeLightbox(){
 $('#lightbox').classList.remove('open');
}
$('#closeLightbox').addEventListener('click',closeLightbox);
$('#lightbox').addEventListener('click',event=>{
 if(event.target===$('#lightbox'))closeLightbox();
});

/* Wishlist */
const wishlistKey='kaalaverseWishlist';
const wishlistId=item||'general-artwork';

function getWishlist(){
 try{return JSON.parse(localStorage.getItem(wishlistKey)||'[]')}
 catch{return []}
}
function setWishlist(list){
 try{
  localStorage.setItem(wishlistKey,JSON.stringify(list));
  return true;
 }catch{return false}
}
function updateWishlistButton(){
 const saved=getWishlist().includes(wishlistId);
 $('#wishlistButton').textContent=saved?'♥':'♡';
 $('#wishlistButton').classList.toggle('saved',saved);
 $('#wishlistButton').setAttribute('aria-pressed',String(saved));
}
updateWishlistButton();

$('#wishlistButton').addEventListener('click',()=>{
 let list=getWishlist();
 list=list.includes(wishlistId)
  ?list.filter(id=>id!==wishlistId)
  :[...list,wishlistId];

 if(!setWishlist(list)){
  alert('Could not save wishlist in this browser.');
  return;
 }
 updateWishlistButton();
});

/* Enquiry form */
$('#enquireButton').addEventListener('click',()=>{
 $('#formStatus').style.display='none';
 $('#enquiryModal').classList.add('open');
 $('#customerName').focus();
});

function closeModal(){
 $('#enquiryModal').classList.remove('open');
}
$('#closeModal').addEventListener('click',closeModal);

$('#enquiryModal').addEventListener('click',event=>{
 if(event.target===$('#enquiryModal'))closeModal();
});

document.addEventListener('keydown',event=>{
 if(event.key==='Escape'){
  closeModal();
  closeLightbox();
 }
});

$('#enquiryForm').addEventListener('submit',async event=>{
 event.preventDefault();
 if(!event.currentTarget.reportValidity())return;

 const data=new FormData(event.currentTarget);
 const message=
 'Kaalaverse Artwork Enquiry\n'+
 'Artwork: '+$('#productTitle').textContent+'\n'+
 'Name: '+data.get('name')+'\n'+
 'Email: '+data.get('email')+'\n'+
 'Message: '+data.get('message');

 try{
  await navigator.clipboard.writeText(message);
  $('#formStatus').textContent='Enquiry message copied. You can now send it to the Kaalaverse team. It has not been sent automatically.';
 }catch{
  $('#formStatus').textContent='Your enquiry is ready. Copy the form details and send them to the Kaalaverse team. It has not been sent automatically.';
 }
 $('#formStatus').style.display='block';
});

$('#year').textContent=new Date().getFullYear();
</script>
</body>
</html>
